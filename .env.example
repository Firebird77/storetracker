# Copier en .env puis relancer `npx expo start -c`. Toutes les variables sont optionnelles.

# Nombre de magasins par page
EXPO_PUBLIC_PAGE_SIZE=20

# Latence simulée de l'API mockée (ms)
EXPO_PUBLIC_MOCK_LATENCY_MS=500

# Probabilité d'erreur de l'API mockée (0 à 1), pour tester les erreurs
EXPO_PUBLIC_MOCK_ERROR_RATE=0
